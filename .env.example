# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# anthropic = chamadas reais à Anthropic
# openai_compat = OpenRouter, Gemini, OpenAI (veja o bloco no fim do arquivo)
# fake = respostas simuladas, só para testar a instalação
PROVEDOR=anthropic
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Modelo pequeno e barato é suficiente para a aula.
MODELO=claude-haiku-4-5-20251001

# Preço em dólares por milhão de tokens, usado para calcular o custo.
# Confira a página de preços do provedor antes da aula e ajuste se mudou.
PRECO_ENTRADA_USD_POR_MILHAO=1.00
PRECO_SAIDA_USD_POR_MILHAO=5.00

SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Alternativa mais barata: OpenRouter (uma chave para Claude, GPT, Qwen, DeepSeek...)
# Para usar, troque PROVEDOR para openai_compat e descomente as linhas abaixo.
# O preço muda com o modelo: confira na página do modelo em openrouter.ai e ajuste
# PRECO_ENTRADA e PRECO_SAIDA acima, senão o custo do placar sai errado.
# Por padrão, o projeto pede ao OpenRouter só provedores que não coletam dados,
# o provedor mais barato para o modelo escolhido e, quando há ferramentas, só
# provedores que aceitam tools e tool_choice.
#
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=sua-chave-do-openrouter
# MODELO=google/gemini-2.5-flash-lite    # US$ 0,10 / 0,40 por milhão (out/2026)
# MODELO=deepseek/deepseek-v4-flash      # US$ 0,09 / 0,18 no provedor mais barato (out/2026)
# MODELO=anthropic/claude-haiku-4.5      # o mesmo Haiku, pelo OpenRouter
#
# Para escolher com números: python encontro-04/preparo/comparar_modelos.py (README do Encontro 4).
#
# OPENROUTER_ORDENAR=price              # vazio = roteamento padrão do OpenRouter
# OPENROUTER_DATA_COLLECTION=deny
